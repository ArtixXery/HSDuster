<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RomperCartas</AssemblyName>
    <RootNamespace>RomperCartas</RootNamespace>
    <Version>0.2.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <HdtDir>$(LOCALAPPDATA)\HearthstoneDeckTracker\current</HdtDir>
    <HdtPlugins>$(APPDATA)\HearthstoneDeckTracker\Plugins</HdtPlugins>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Ensamblados de HDT: se usan los de la instalación local y no se copian al plugin -->
  <ItemGroup>
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HdtDir)\HearthstoneDeckTracker.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HdtDir)\HearthDb.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HdtDir)\HearthMirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HdtDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Archivos que acompañan al .dll: Plugins\RomperCartas\datos y Plugins\RomperCartas\scripts -->
  <ItemGroup>
    <Incluidos Include="..\..\datos\*.json" Carpeta="datos" />
    <Incluidos Include="..\..\scripts\*.py;..\..\scripts\requirements.txt" Carpeta="scripts" />
  </ItemGroup>

  <!-- dotnet build -c Release -p:Instalar=true copia el plugin y sus archivos a la carpeta de HDT -->
  <Target Name="InstalarEnHdt" AfterTargets="Build" Condition="'$(Instalar)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HdtPlugins)" />
    <Copy SourceFiles="@(Incluidos)" DestinationFolder="$(HdtPlugins)\RomperCartas\%(Incluidos.Carpeta)" />
  </Target>

</Project>
